{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WoW MCP Control Center",
  "version": "0.5.0",
  "identifier": "dev.wowmcp.controlcenter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WoW Connect",
        "width": 950,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#f7f8fa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/wow-mcp-service"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
